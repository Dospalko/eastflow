---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
}

const { title, description, lang = 'sk' } = Astro.props;
---

<!doctype html>
<html lang={lang} data-type="service" data-radius="soft" data-buttons="arrow" data-motion>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content="/share.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#f7f7f5">
  <!-- <link rel="canonical" href="https://eastflow.example/"> -->
  <meta name="site-kind" content="other">
  <meta name="page-type" content="service">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/system.css">
  <link rel="stylesheet" href="/assets/ui/cards.css">
  <link rel="stylesheet" href="/assets/motion/motion.css">
  <link rel="stylesheet" href="/assets/layout/layout.css">
  <link rel="stylesheet" href="/assets/moments/pinned-chapters/moment.css">
  <style is:inline>
    :root {
      --p-bg: #f7f7f5; --p-surface: #ebebe8; --p-ink: #000000; --p-muted: #666662;
      --p-accent: #d0106f; --p-accent-ink: #ffffff; --p-action: #d0106f; --p-action-ink: #ffffff;
      --p-inv-bg: #000000; --p-inv-surface: #010101; --p-inv-ink: #f7f7f5; --p-inv-muted: #828280;
      --p-inv-accent: #d0106f; --p-inv-accent-ink: #ffffff; --p-inv-action: #d0106f; --p-inv-action-ink: #ffffff;
      --font-display: "Onest", system-ui, sans-serif;
      --font-text: "Onest", system-ui, sans-serif;
      --display-weight: 400;
      --display-tracking: -0.035em;
      --display-tracking-xl: -0.04em;
    }
  </style>
  <script is:inline>
    document.documentElement.classList.add('m-enter');
    setTimeout(() => document.documentElement.classList.add('m-enter-done'), 700);
    document.documentElement.classList.add('mo-js');
    setTimeout(() => document.documentElement.classList.add('mo-safe'), 2500);
  </script>
  <link rel="modulepreload" href="/assets/moments/moments.js">
  <link rel="modulepreload" href="/assets/moments/lib.js">
  <link rel="modulepreload" href="/assets/moments/pinned-chapters/moment.js">
</head>
<body>
  <slot />
  <script type="module" src="/assets/system.js"></script>
  <script type="module" src="/assets/motion/motion.js"></script>
  <script type="module" src="/assets/layout/layout.js"></script>
</body>
</html>
