---
import BaseLayout from '../layouts/BaseLayout.astro';

interface ServiceItem {
  name: string;
  detail: string;
  duration: string;
}

const services: ServiceItem[] = [
  {
    name: 'Audit firemných procesov',
    detail: 'Sadneme si s tímom, zmapujeme úzke miesta a vyčíslime ušetrené hodiny',
    duration: '5 dní',
  },
  {
    name: 'Automatizácia dokladov a faktúr',
    detail: 'Prevod PDF objednávok, dodacích listov a e-mailov priamo do ERP',
    duration: '14 dní',
  },
  {
    name: 'Interný firemný asistent',
    detail: 'Súkromné vyhľadávanie nad smernicami, zmluvami a zákazkami',
    duration: '14 dní',
  },
  {
    name: 'Zaškolenie a odovzdanie tímu',
    detail: 'Praktické workshopy, aby vaši ľudia riešenie denne používali',
    duration: 'V cene',
  },
];
---

<BaseLayout
  title="EastFlow AI: implementácia AI do procesov na východe Slovenska"
  description="Vývojári, ktorí prídu do vašej firmy na východnom Slovensku, zmapujú pomalé procesy a nasadia AI automatizáciu do 14 dní."
>
  <header class="nav">
    <div class="wrap nav__bar">
      <a class="skip-link" href="#top">Preskočiť na obsah</a>
      <a class="nav__logo" href="#top">EastFlow AI</a>
      <nav class="nav__links" aria-label="Hlavná navigácia">
        <div class="nav__item">
          <a class="nav__link" href="#services">Služby <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <div class="nav__menu">
            <div class="wrap grid">
              <div class="menu-col span-4">
                <p class="t-label">Analýza</p>
                <a href="#services">Audit procesov<span>Zmapovanie práce priamo vo firme</span></a>
                <a href="#process">Rozhovory s tímom<span>Rozprávame sa s ľuďmi v prevádzke</span></a>
              </div>
              <div class="menu-col span-4">
                <p class="t-label">Implementácia</p>
                <a href="#services">Doklady a ERP<span>Prepis PDF a mailov bez chýb</span></a>
                <a href="#audit">14-dňový pilot<span>Prvá funkčná automatizácia naostro</span></a>
              </div>
              <a class="menu-card span-3 start-10" href="#audit">
                <div class="panel"><img class="frame__img" src="/assets/img/photo-f202379730-500.jpg" alt="Vývojári a zástupcovia firmy pri spoločnom návrhu automatizácie"></div>
                <span class="t-card">14-dňový pilot</span>
                <span class="t-small muted">Prvý zrýchlený proces do dvoch týždňov</span>
              </a>
            </div>
          </div>
        </div>
        <div class="nav__item"><a class="nav__link" href="#process">Postup</a></div>
        <div class="nav__item"><a class="nav__link" href="#audit">Audit</a></div>
      </nav>
      <div class="nav__actions">
        <a class="btn btn--primary" href="#audit">Objednať audit procesov<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
      </div>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
    </div>
  </header>

  <main id="top">
    <section class="hero hero--photo" data-enter data-calm="left" aria-labelledby="hero-h">
      <img
        class="hero__bg"
        src="/assets/img/photo-f186269457.jpg"
        srcset="/assets/img/photo-f186269457-500.jpg 500w, /assets/img/photo-f186269457-960.jpg 960w, /assets/img/photo-f186269457-1280.jpg 1280w, /assets/img/photo-f186269457.jpg 1920w"
        sizes="(max-width: 639px) 188vw, 100vw"
        width="1920"
        height="1280"
        alt="Vývojár pri osobnom rozhovore a zápise poznámok vo firme"
        style="--ly-pos: 70% 35%; --ly-pos-phone: 65% 30%"
        fetchpriority="high"
        decoding="async"
        data-phone-fill
        data-source="stand-in"
        data-subject="stand-in"
      >
      <div class="wrap"><div class="hero-text">
        <div class="hero__text">
          <h1 id="hero-h">Implementácia AI pre firmy na východe</h1>
          <p class="hero__lead">Naši vývojári prídu k vám do firmy v Košiciach či Prešove, vypočujú si ľudí v prevádzke a zapoja AI do vašich procesov do 14 dní.</p>
          <div class="btn-row">
            <a class="btn btn--primary" href="#audit">Objednať audit procesov<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
            <a class="btn btn--secondary" href="#process">Pozrieť postup</a>
          </div>
        </div>
      </div></div>
    </section>

    <section class="section" id="services" aria-labelledby="services-h">
      <div class="wrap grid grid--top">
        <div class="span-6">
          <div class="section-head">
            <h2 id="services-h">Služby AI automatizácie</h2>
            <p>Nástroje na mieru napojené priamo na softvér, ktorý už vo firme používate.</p>
          </div>
          <ul class="rows">
            {services.map((item) => (
              <li>
                <span class="rows__name">{item.name}<small>{item.detail}</small></span>
                <span class="rows__value">{item.duration}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="span-5 start-8">
          <div class="services__photo">
            <img
              src="/assets/img/photo-f202379730.jpg"
              srcset="/assets/img/photo-f202379730-500.jpg 500w, /assets/img/photo-f202379730-960.jpg 960w, /assets/img/photo-f202379730.jpg 1280w"
              sizes="(max-width: 639px) 188vw, (max-width: 1023px) 100vw, 50vw"
              width="1280"
              height="853"
              alt="Konzultanti a zamestnanci firmy pri kontrole zautomatizovaných krokov"
              loading="lazy"
              decoding="async"
              data-source="stand-in"
              data-subject="stand-in"
            >
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="process" data-moment="pinned-chapters" aria-labelledby="process-h">
      <div class="wrap mo-pc__grid">
        <div class="mo-pc__text">
          <h2 id="process-h">Postup implementácie vo firme</h2>
          <ol class="mo-pc__steps">
            <li class="mo-pc__step">
              <h3>Rozhovory s ľuďmi v prevádzke</h3>
              <p>Sadneme si s kolegami na sklade, obchode aj účtarni a zistíme, kde strácajú čas ručným prepisovaním.</p>
              <figure class="mo-pc__visual">
                <img
                  src="/assets/img/photo-f146486066.jpg"
                  srcset="/assets/img/photo-f146486066-500.jpg 500w, /assets/img/photo-f146486066-960.jpg 960w, /assets/img/photo-f146486066.jpg 1280w"
                  sizes="(max-width: 1023px) 100vw, 50vw"
                  alt="Technický tím pri spoločnom mapovaní pracovných postupov"
                  width="1280"
                  height="719"
                  loading="lazy"
                  decoding="async"
                  data-source="stand-in"
                  data-subject="stand-in"
                >
              </figure>
            </li>
            <li class="mo-pc__step">
              <h3>Napojenie na systémy a školenie</h3>
              <p>Prepojíme AI s vaším CRM alebo ERP s kontrolou človeka pred zápisom a zaškolíme celý tím.</p>
              <figure class="mo-pc__visual">
                <img
                  src="/assets/img/photo-f193072089-960.jpg"
                  srcset="/assets/img/photo-f193072089-500.jpg 500w, /assets/img/photo-f193072089-960.jpg 960w"
                  sizes="(max-width: 1023px) 100vw, 50vw"
                  alt="Vývojári a vedenie firmy pri nasadení nového prehľadového systému"
                  width="960"
                  height="640"
                  loading="lazy"
                  decoding="async"
                  data-source="stand-in"
                  data-subject="stand-in"
                >
              </figure>
            </li>
          </ol>
        </div>
        <div class="mo-pc__visuals frame"></div>
      </div>
    </section>

    <section class="section" id="audit" aria-labelledby="audit-h">
      <div class="wrap grid grid--top">
        <div class="span-6">
          <div class="section-head">
            <h2 id="audit-h">Objednať audit procesov</h2>
            <p>Napíšte nám, ktoré oddelenie alebo ručná práca vás najviac brzdí. Dvaja vývojári si pozrú zadanie a dohodnú si 30-minútové stretnutie.</p>
          </div>
          <div class="audit__photo">
            <img
              src="/assets/img/photo-f196662871.jpg"
              srcset="/assets/img/photo-f196662871-500.jpg 500w, /assets/img/photo-f196662871-960.jpg 960w, /assets/img/photo-f196662871.jpg 1280w"
              sizes="(max-width: 1023px) 100vw, 50vw"
              width="1280"
              height="719"
              alt="Inžinieri pripravujúci technické riešenie na nasadenie u zákazníka"
              loading="lazy"
              decoding="async"
              data-source="stand-in"
              data-subject="stand-in"
            >
          </div>
        </div>
        <div class="span-5 start-8">
          <form class="form" action="mailto:ahoj@eastflow.example" method="post" enctype="text/plain" data-endpoint="" data-sent="Dopyt na audit procesov je odoslaný. Ozveme sa do jedného pracovného dňa." aria-labelledby="audit-h" novalidate>
            <div class="field">
              <label for="f-name">Vaše meno</label>
              <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="f-name-err">
              <p class="field__error" id="f-name-err" hidden>Napíšte svoje meno, aby sme vedeli, koho osloviť.</p>
            </div>
            <div class="field">
              <label for="f-email">Pracovný e-mail</label>
              <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" autocorrect="off" autocapitalize="none" spellcheck="false" required aria-describedby="f-email-err">
              <p class="field__error" id="f-email-err" hidden>Zadajte e-mailovú adresu so znakom @, napríklad meno@firma.sk.</p>
            </div>
            <div class="field">
              <label for="f-process">Firma a proces na zrýchlenie</label>
              <input id="f-process" name="process" type="text" autocomplete="organization" required aria-describedby="f-process-err">
              <p class="field__error" id="f-process-err" hidden>Napíšte názov firmy a proces, ktorý chcete zautomatizovať.</p>
            </div>
            <div class="btn-row">
              <button class="btn btn--primary" type="submit">Objednať audit procesov<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></button>
            </div>
            <p class="form__status" role="status" data-form-status></p>
            <p class="t-small muted">Odpovedáme do jedného pracovného dňa.</p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer closing" id="contact" aria-labelledby="close-h">
    <div class="wrap">
      <div class="closing__cta close--type">
        <div class="section-head">
          <h2 id="close-h">Uberte tímu zbytočnú ručnú prácu</h2>
          <p>Začnite 30-minútovým prehľadom procesov priamo s našimi vývojármi.</p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="#audit">Objednať audit procesov<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
        </div>
      </div>
      <div class="closing__links">
        <div class="grid">
          <div class="span-6 stack-4">
            <a class="nav__logo" href="#top">EastFlow AI</a>
            <p class="footer__lede">Vývojári pre východné Slovensko, ktorí sa rozprávajú s ľuďmi a zrýchľujú firemné procesy cez AI.</p>
          </div>
          <div class="span-3 start-7 footer__col">
            <h3>Služby</h3>
            <ul>
              <li><a href="#services">Audit procesov</a></li>
              <li><a href="#services">Doklady a ERP</a></li>
              <li><a href="#process">Postup implementácie</a></li>
            </ul>
          </div>
          <div class="span-3 footer__col">
            <h3>Kontakt</h3>
            <ul>
              <li><a href="#audit">Objednať audit</a></li>
              <li><a href="mailto:ahoj@eastflow.example">Napísať vývojárom</a></li>
            </ul>
          </div>
        </div>
        <div class="footer__legal">
          <span>&copy; 2026 EastFlow AI</span>
          <a href="/privacy">Ochrana údajov</a>
          <a href="/terms">Podmienky</a>
          <div class="socials"></div>
          <a class="credits" href="/credits">Fotografie z Wikimedia Commons</a>
        </div>
      </div>
    </div>
  </footer>

  <nav class="actionbar" aria-label="Rýchla akcia">
    <a class="btn btn--primary" href="#audit">Objednať audit procesov</a>
  </nav>
</BaseLayout>
